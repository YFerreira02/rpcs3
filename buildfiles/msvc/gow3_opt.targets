<?xml version="1.0" encoding="utf-8"?>
<!-- Rama pgo-instr: opciones de gow3-zen (LTCG + AVX2 + /favor:AMD64) y
     enlace instrumentado para optimización guiada por perfil (PGO).
     El rpcs3.exe resultante es más lento: solo sirve para grabar perfiles
     (.pgc) jugando en el equipo de destino. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)ci_only.targets" />
  <ItemDefinitionGroup>
    <ClCompile>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <AdditionalOptions>/favor:AMD64 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>PGInstrument</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
</Project>
