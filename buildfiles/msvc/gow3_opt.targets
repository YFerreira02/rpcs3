<?xml version="1.0" encoding="utf-8"?>
<!-- Rama pgo: opciones de gow3-zen (LTCG + AVX2 + /favor:AMD64) y enlace
     optimizado con el perfil (PGO) grabado jugando God of War III en el
     equipo de destino: bin\rpcs3.pgd + bin\rpcs3!N.pgc. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)ci_only.targets" />
  <ItemDefinitionGroup>
    <ClCompile>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <AdditionalOptions>/favor:AMD64 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link Condition="'$(ProjectName)'=='rpcs3'">
      <LinkTimeCodeGeneration>PGOptimization</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
</Project>
